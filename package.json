{
  "name": "personal-blog-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "content:generate": "node scripts/generate-search-index.mjs && node scripts/prepare-resume.mjs",
    "predev": "npm run content:generate && npm run theme:css",
    "dev": "next dev",
    "prebuild": "npm run content:generate && npm run theme:css",
    "build": "next build",
    "postbuild": "node scripts/finalize-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "theme:css": "node scripts/build-theme-css.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.12.0",
    "next": "^15.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.33",
    "typescript": "^5.9.0"
  }
}
